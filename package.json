{
  "name": "crossamp",
  "version": "0.1.0",
  "private": true,
  "description": "Reproductor de audio cross-platform inspirado en Winamp",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:engine:build": "node test/build.mjs",
    "test:engine": "npm run test:engine:build && node test/run.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
